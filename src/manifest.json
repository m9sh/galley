{
  "manifest_version": 3,
  "name": "Galley: Clearer reviews for GitHub & GitLab",
  "short_name": "Galley",
  "description": "Understand GitHub and GitLab changes: readable docs and code, edits in context, and comments beside the text.",
  "homepage_url": "https://github.com/m9rc1n/galley",
  "version": "0.0.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Galley",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://github.com/*", "https://gitlab.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gitlab.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": ["diagram-frame.html", "highlight-frame.html", "spec-frame.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self'; style-src 'unsafe-inline'"
  },
  "web_accessible_resources": [
    {
      "resources": ["diagram-frame.html", "highlight-frame.html", "spec-frame.html"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ]
}
