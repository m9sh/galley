language js(typescript)

// Strings written as HTML are an XSS risk in an extension that renders pull request content.
// Document text must reach the page through the sanitiser (src/ui/rendering/render.ts) or as text nodes.
// Markup bundled with the extension (icons, templates) is parsed by markup() and glyph() in
// src/ui/components/dom.ts, the one place that may parse a string as HTML (ADR 0033).
or {
  `$target.innerHTML = $value`,
  `$target.outerHTML = $value`,
  `$target.insertAdjacentHTML($position, $html)`,
  `document.write($html)`,
  `document.writeln($html)`,
  `$parser.parseFromString($html, $type)`
} as $sink where {
  // Tests build fixtures from literals; the rule is for code that ships.
  $filename <: not r".*\.test\.ts$",
  $filename <: not r".*e2e/.*",
  // The one parser of bundled markup.
  $filename <: not r".*src/ui/components/dom\.ts$",
  register_diagnostic(span=$sink, message="Writing or parsing a string as HTML bypasses the sanitiser. Use text nodes or DOM methods, markup() or glyph() for bundled markup, or sanitise first (src/ui/rendering/render.ts).", severity="error")
}
