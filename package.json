{
  "name": "galley",
  "version": "0.9.0",
  "private": true,
  "description": "Galley helps teams understand GitHub pull requests and GitLab merge requests with readable documents and code, edits shown in context, and comments beside the text. Free and open source.",
  "license": "GPL-3.0-or-later",
  "author": "Marcin Urbanski",
  "homepage": "https://github.com/m9rc1n/galley#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m9rc1n/galley.git"
  },
  "bugs": {
    "url": "https://github.com/m9rc1n/galley/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:zip": "node scripts/dev.mjs --zip",
    "zip": "node scripts/build.mjs --zip",
    "demo": "node scripts/build.mjs && node scripts/serve.mjs",
    "build:site": "node scripts/build.mjs && node scripts/build-site.mjs",
    "site": "npm run build:site && node scripts/serve-site.mjs",
    "test:site": "node e2e/site.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/build.mjs && node e2e/reader.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "prepare": "node scripts/install-hooks.mjs",
    "store-assets": "node scripts/build.mjs && node scripts/store-assets.mjs",
    "artwork": "node scripts/artwork-preview.mjs",
    "release": "npm run check && node scripts/build.mjs --zip && node scripts/privacy-page.mjs",
    "privacy-page": "node scripts/privacy-page.mjs",
    "submit-helper": "node scripts/submit-helper.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
