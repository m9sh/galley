{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/reports", "!demo/build", "!demo/samples", "!store/assets", "!package-lock.json"]
  },
  // Wide lines on purpose: much of this code reads best as one statement per line.
  // `npm run format` applies it; CI and the pre-push hook fail on unformatted files.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  // The custom lint rule is laid out by hand, and GritQL formatting is still experimental.
  "grit": { "formatter": { "enabled": false } },
  "assist": { "enabled": false },
  // A custom rule for the one risk an extension that renders pull request content cannot take.
  "plugins": ["./lint/no-unsanitized-html.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        // Many code paths here are async (storage, network, rendering); an unhandled one fails silently.
        // Intentional fire-and-forget calls say so with `void`.
        "noFloatingPromises": "error"
      },
      "suspicious": {
        // A module that imports itself back through others cannot be read, tested or moved on its own.
        "noImportCycles": "error"
      },
      "performance": {
        // Import from the module that defines a thing, not from one that passes it along.
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "correctness": {
        // What the code imports is declared in package.json, not left to whatever the install hoists.
        "noUndeclaredDependencies": "error"
      },
      "style": {
        // Files are named in kebab-case, like the folders around them.
        "useFilenamingConvention": { "level": "error", "options": { "strictCase": true, "requireAscii": true, "filenameCases": ["kebab-case"] } },
        "noExportedImports": "error",
        // Strict null checks are on. DOM code often looks up an element it has just rendered, and tests
        // assert on what they have just built, so `!` is clearer than a guard that cannot fail.
        "noNonNullAssertion": "off",
        // The reader's stylesheet is one deliberate cascade of layered overrides.
        "noDescendingSpecificity": "off"
      }
    }
  }
}
